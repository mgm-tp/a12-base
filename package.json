{
  "name": "@com.mgmtp.a12.base/root",
  "version": "30.1.1",
  "a12ReleaseLine": "2026.06",
  "description": "Base Workspaces Root",
  "author": "mgm technology partners",
  "type": "module",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "engines": {
    "node": "^24",
    "pnpm": "^12"
  },
  "private": true,
  "scripts": {
    "clean": "pnpm run -r --parallel clean",
    "verify": "pnpm run \"/^(format|lint|spellcheck)$/\"",
    "verify:fix": "pnpm run \"/^(format:fix|lint:fix)$/\"",
    "build": "pnpm run -r build",
    "compile": "pnpm run -r compile",
    "test": "pnpm run -r test",
    "format": "oxfmt --check \"**/src/**/*.{ts,tsx}\"",
    "format:fix": "oxfmt --write \"**/src/**/*.{ts,tsx}\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "lint:onlyErrors": "oxlint --quiet .",
    "spellcheck": "pnpm run -r --parallel spellcheck"
  },
  "devDependencies": {
    "@tony.ganchev/eslint-plugin-header": "catalog:",
    "@types/node": "catalog:",
    "eslint-plugin-workspaces": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  },
  "packageManager": "pnpm@12.3.4"
}
