{
	"include": ["oxfmt.config.ts", "oxlint.config.ts"],
	"compilerOptions": {
		"allowImportingTsExtensions": true,
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"module": "NodeNext",
		"lib": ["esnext"],
		"erasableSyntaxOnly": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"moduleDetection": "force"
	}
}
