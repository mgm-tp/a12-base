{
  "name": "@com.mgmtp.a12.base/base-codemod",
  "version": "29.3.2",
  "description": "Base Codemod",
  "author": "mgm technology partners",
  "license": "(EUPL-1.2 OR LicenseRef-commercial)",
  "bin": "lib/cli.js",
  "type": "module",
  "scripts": {
    "clean": "rimraf ./lib",
    "build": "node --run compile",
    "compile": "tsc",
    "watch": "tsc --watch",
    "runner": "node --import ./scripts/resolveSnapshot.ts --test --test-reporter=dot",
    "test": "node --run runner -- \"lib/test/*.test.js\"",
    "test:updateSnapshots": "node --run runner -- --test-update-snapshots \"lib/test/*.test.js\""
  },
  "devDependencies": {
    "@com.mgmtp.a12.devtools/tsconfig": "catalog:a12",
    "@types/node": "catalog:",
    "rimraf": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@com.mgmtp.a12.devtools/codemod": "catalog:a12",
    "ts-morph": "catalog:"
  },
  "files": [
    "lib",
    "!lib/test",
    "!lib/testData",
    "src",
    "!src/test",
    "!src/testData",
    "cyclonedx.json",
    "NOTICE",
    "THIRD_PARTY_NOTICES",
    "licenses"
  ]
}
