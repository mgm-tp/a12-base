root = true

[**]
indent_style = tab
trim_trailing_whitespace = true
insert_final_newline = true

[*.{md,adoc}]
trim_trailing_whitespace = false

[*.{json,yaml}]
indent_style = space
indent_size = 2

[*.{xml,xsd,gradle,groovy}]
indent_style = space
indent_size = 4

[license_header.txt]
insert_final_newline = false
