    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12",
    "@microsoft/api-extractor": "catalog:",
    "@types/node": "catalog:",
    "typedoc-plugin-missing-exports": "catalog:",
    "typedoc": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@com.mgmtp.a12.utils/utils-localization": "catalog:a12ranges"
  },
  "files": [
    "lib",
    "!lib/test",
    "src",
    "!src/test",
