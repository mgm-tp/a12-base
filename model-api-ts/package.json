{
  "name": "@com.mgmtp.a12.base/base-model-api",
  "version": "30.0.1",
  "description": "Model API",
  "type": "module",
  "sideEffects": false,
  "exports": "./lib/main/index.js",
  "scripts": {
    "clean": "git clean -fx .",
    "build": "node --run compile && node --run verify && node --run validate:api&& typedoc",
